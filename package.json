{
  "name": "website-scorecard",
  "version": "2.0.0",
  "description": "Evidence-based website scorecard for finding conversion and revenue leaks in local home-service businesses.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22",
    "python": ">=3.10"
  },
  "keywords": [
    "website-audit",
    "conversion-rate-optimization",
    "local-business",
    "home-services",
    "lead-generation",
    "revenue-operations",
    "lighthouse",
    "marketing-automation",
    "website-scorecard",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thatguynef/website-scorecard.git"
  },
  "homepage": "https://radicalredrocket.com",
  "bugs": {
    "url": "https://github.com/thatguynef/website-scorecard/issues"
  },
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "doctor": "node scripts/doctor.mjs",
    "collect": "node .opencode/skills/home-service-website-audit/scripts/collect.mjs",
    "score": "python3 .opencode/skills/home-service-website-audit/scripts/score.py",
    "render": "node .opencode/skills/home-service-website-audit/scripts/render.mjs",
    "verify": "node .opencode/skills/home-service-website-audit/scripts/verify.mjs",
    "eval": "node .opencode/skills/home-service-website-audit/scripts/eval.mjs",
    "test": "python3 -m unittest discover -s .opencode/skills/home-service-website-audit/scripts -p 'test_*.py' && node --test .opencode/skills/home-service-website-audit/scripts/test_pipeline.mjs",
    "check:rubric": "python3 .opencode/skills/home-service-website-audit/scripts/validate_rubric.py",
    "check:generated": "python3 .opencode/skills/home-service-website-audit/scripts/render_rubric.py --check && python3 .opencode/skills/home-service-website-audit/scripts/render_coverage.py --check && python3 .opencode/skills/home-service-website-audit/scripts/render_portable.py --check && python3 .opencode/skills/home-service-website-audit/scripts/render_rubric.py --rubric .opencode/skills/home-service-website-audit/references/legacy/rubric-v1.1.3.json --out .opencode/skills/home-service-website-audit/references/legacy/rubric-v1.1.3.md --check",
    "check:privacy": "node scripts/privacy_scan.mjs",
    "check:assets": "node scripts/check_assets.mjs",
    "render:assets": "node scripts/render_docs_assets.mjs",
    "docs:build": "python3 -m mkdocs build --strict",
    "docs:serve": "python3 -m mkdocs serve",
    "check": "npm test && npm run check:rubric && npm run check:generated && npm run check:schemas && npm run check:links && npm run check:assets && npm run check:privacy",
    "verify:example": "node .opencode/skills/home-service-website-audit/scripts/verify.mjs --run examples/acme-plumbing --report examples/acme-plumbing/full-report.md --one-page examples/acme-plumbing/one-page.md --index examples/README.md --mutation --fixture --synthetic",
    "render:example": "npm run render -- --scores examples/acme-plumbing/scores.json --content examples/acme-plumbing/content.json --out examples/acme-plumbing/one-page.md && npm run render -- --mode full --scores examples/acme-plumbing/scores.json --content examples/acme-plumbing/content.json --out examples/acme-plumbing/full-report.md",
    "check:schemas": "python3 -m json.tool .opencode/skills/home-service-website-audit/references/schema/audit-v2.schema.json > /dev/null && python3 -m json.tool .opencode/skills/home-service-website-audit/references/schema/scores-v2.schema.json > /dev/null",
    "check:links": "node scripts/check_links.mjs"
  }
}
